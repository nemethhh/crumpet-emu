+        arm_device(emu)
+        namep = SCRATCH + 0x90
+        emu.uc.mem_write(namep, b'tee1\x00')
+        tee_addr, tee_size = SCRATCH + 0x48, SCRATCH + 0x4C
+        emu.uc.mem_write(tee_addr, struct.pack('<I', TEE_LOAD_ADDR))
+        ret = emu.try_call(TEE_LOADER, (namep, BDEV, tee_addr, 0, tee_size),
+                           timeout=120_000_000)
